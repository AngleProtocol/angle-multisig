# Multisig operations environment
# Secrets resolved via 1Password CLI (op run)

# eRPC — same endpoint as merkl engine
ERPC_URL=https://rpc.internal.merkl.xyz/main/evm

# Safe Transaction Service submission
# SENDER = the public address of the signer/delegate proposing the tx
# PRIVATE_KEY = the private key of that signer (used to sign the tx hash)
SENDER="op://Multisig/MULTISIG_SENDER/token"
PRIVATE_KEY="op://Multisig/MULTISIG_PRIVATE_KEY/token"
